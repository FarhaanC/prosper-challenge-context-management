+# =============================================================== s3: no preference stored as ""
+NO_PREF_WORDS = ["any", "Any", "anyone", "anywhere", "I don't mind", "dont mind", "no preference", "No Preference",
+                 "whatever", "whenever", "doesn't matter", "  anywhere  ", "anything"]
