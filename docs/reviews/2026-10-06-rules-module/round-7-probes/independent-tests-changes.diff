+
+
+@pytest.mark.parametrize("name,lid", [("Richmund", "loc_007"), ("mid town", "loc_005"), ("Marina District", "loc_003"),
+                                      ("Downtown SF", "loc_004"), ("Mission Bay Health Center", "loc_000"),
