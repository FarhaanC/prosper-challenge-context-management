+                continue
+            cut += " more " in notes[0]
+            problems += [((kind, VT[vt]["name"], heard), p, notes[0])
+                         for p in cant_note_problems(notes[0], heard, family, PROV, loc, is_new, vt, pairs)]
+    assert not problems, (len(problems), problems[:4])
